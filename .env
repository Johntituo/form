# Copy this file to .env for local development, then replace both values.
# Never upload your real .env file to GitHub.
ADMIN_PASSWORD=replace-this-with-a-long-unique-password-at-least-12-chars
SESSION_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
# Optional. On Render, attach a persistent disk mounted at /var/data and set DATA_DIR=/var/data
# DATA_DIR=/var/data
NODE_ENV=development
PORT=8765
